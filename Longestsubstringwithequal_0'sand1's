#include <iostream>
#include <string>
#include <algorithm>
using namespace std;
int main() {
    string s;
    cin >> s;
    int z = 0, o = 0, l = 0;
    for (int i = 0; i < s.length(); i++) {
        if (s[i] == '0') {
            if (i > 0 && s[i-1] == '1') {
                z = 0;
                o = 0;
            }
            z++;
        } else {
            o++;
            l = max(l, 2 * min(z, o));
        }
    }
    cout << l << endl; // Print the result before returning
    return l;
}
